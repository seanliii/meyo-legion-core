    ]
  },
  "verification_notes": {
    "scope": "Prime JSONL v3 接线与无网 fixture 回归；未安装、未模型实跑、未验证跨版本 kernel 快照。",
    "resume": "Prime专属CLI读取runtime_context_json及原JSONL旁身份记录；保留路径/ID/daemon socket。通用registry及parser不改。",
    "runtime": "沿用 b93c72c 固定官方 revision、CLI、独立 Python venv；不混用本机0.8 runtime。",
    "pending": [
      "A窗口同包真实CLI、模型及工具运行",
      "原生取消/daemon回收",
      "同版本及跨版本kernel快照恢复验证"
    ]
  }
}
