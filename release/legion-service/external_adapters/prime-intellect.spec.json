{
  "key": "prime-intellect",
  "name": "Prime Agent (Prime Intellect)",
  "kind": "agent",
  "execution_role": "agent",
  "url": "https://github.com/PrimeIntellect-ai/prime-agent",
  "version": "0.9.4+1eee2938b4ee",
  "revision": "1eee2938b4eeb7a4d72e17035adda669a89b63de",
  "runtime": {
    "node": ">=22.8.0",
    "python": ">=3.11"
  },
  "install": [
    [
      "{node}",
      "{npm_cli}",
      "ci",
      "--prefix",
      "{source}"
    ],
    [
      "{node}",
      "{npm_cli}",
      "run",
      "build",
      "--prefix",
      "{source}"
    ],
    [
      "{python}",
      "-m",
      "venv",
      "{runtime_dir}/venv"
    ],
    [
      "{runtime_python}",
      "-m",
      "pip",
      "install",
      "{source}/prime-agent-runtime",
      "dill",
      "requests",
      "httpx",
      "pyyaml",
      "tomli",
      "python-dotenv",
      "pandas",
      "numpy",
      "scipy",
      "beautifulsoup4",
      "lxml",
      "pydantic",
      "tyro"
    ],
    [
      "{runtime_python}",
      "-c",
      "import rlm, rlm.repl, dill, requests, httpx, yaml, tomli, dotenv, pandas, numpy, scipy, bs4, lxml, pydantic, tyro; assert rlm.repl.PROTOCOL_VERSION == 3; assert callable(rlm.spawn); assert callable(rlm.host_request)"
    ],
    [
      "{node}",
      "{source}/packages/coding-agent/dist/bundle/cli.js",
      "--version"
    ]
  ],
  "credentials": {
    "any_of": [
      "MEYO_UNIFIED_APPID",
      "AIGC_APPID"
    ],
    "help": "由现有统一运行入口传入 appid、gateway、model；不需要 Prime 账号，不写入固定密钥。"
  },
  "env": {
    "PRIME_AGENT_CODING_AGENT_DIR": "{session_dir}/prime-intellect/{session_id}/config",
    "PRIME_AGENT_SESSION_DIR": "{session_dir}/prime-intellect/{session_id}/sessions",
    "PRIME_AGENT_KERNEL_PYTHON": "{runtime_python}",
    "PRIME_AGENT_KERNEL_VENV": "{runtime_dir}/venv",
    "MEYO_PRIME_INTELLECT_API_KEY": "{appid}",
    "MEYO_TOOL_CLI": "{tool_cli}",
    "PI_SKIP_VERSION_CHECK": "1"
  },
  "config_template": {
    "path": "{session_dir}/prime-intellect/{session_id}/config/registry-models.json",
    "content": {
      "providers": {
        "meyo": {
          "baseUrl": "{gateway}",
          "api": "openai-completions",
          "apiKey": "MEYO_PRIME_INTELLECT_API_KEY",
          "authHeader": true,
          "compat": {
            "supportsStore": false,
            "supportsDeveloperRole": false,
            "supportsReasoningEffort": false,
            "maxTokensField": "max_tokens"
          },
          "models": [
            {
              "id": "{model}"
            }
          ]
        }
      }
    }
  },
  "transports": [
    {
      "type": "cli",
      "command": [
        "{python}",
        "{adapter_dir}/prime_cli.py",
        "--runtime-context",
        "{runtime_context_json}",
        "--source",
        "{source}",
        "--source-url",
        "https://github.com/PrimeIntellect-ai/prime-agent",
        "--revision",
        "1eee2938b4eeb7a4d72e17035adda669a89b63de",
        "--runtime-dir",
        "{runtime_dir}",
        "--runtime-python",
        "{runtime_python}",
        "--session-root",
        "{session_dir}",
        "--models-json",
        "{session_dir}/prime-intellect/{session_id}/config/registry-models.json",
        "--",
        "{node}",
        "{source}/packages/coding-agent/dist/bundle/cli.js",
        "--mode",
        "json",
        "--print",
        "--daemon-socket",
        "prime.sock",
        "--provider",
        "meyo",
        "--model",
        "{model}",
        "--cwd",
        "{workdir}",
        "--session-dir",
        "{session_dir}/prime-intellect/{session_id}/sessions",
        "--append-system-prompt",
        "Meyo shared tool entry point (CLI, not a Python package): {python} {tool_cli}. Run it with --help to discover available commands. Peer source locations are supplied in MEYO_PEER_SOURCE_CONTEXT. Current project directory: {workdir}.",
        "--",
        "{task}"
      ],
      "native_session_format": "prime_jsonl_v3",
      "snapshot_terminal": true,
      "output_contract": {
        "type": "json",
        "record_match": {
          "type": "prime_native_result"
        },
        "text_field": "final",
        "status_field": "status",
        "completed_statuses": [
          "ok"
        ],
        "session_id_field": "session_id"
      }
    }
  ],
  "probe": {
    "method": "cli",
    "target": "{source}/packages/coding-agent/dist/bundle/cli.js",
    "command": [
      "{node}",
      "{source}/packages/coding-agent/dist/bundle/cli.js",
      "--version"
    ]
  },
  "capabilities": [
    "coding",
    "research",
    "python-repl",
    "shell",
    "files",
    "recursive-subagents",
    "skills",
    "mcp"
  ],
  "provided_tools": [
    "ipython"
  ],
  "adapter_capabilities": {
    "streaming": "events",
    "resume": true,
    "tools": true,
    "artifacts": true,
    "interrupt": true,
    "model": "native"
  },
  "provenance": {
    "official": true,
    "description": "PrimeIntellect-ai 官方仓库；从固定源码构建，不安装 aisa，也不从 npm 安装继承的 pi 包名。"
  },
  "source_evidence": {
    "checked_at": "2026-09-11",
