      "packages/coding-agent/package.json",
      "packages/coding-agent/docs/development.md",
      "scripts/pack-prime-agent-release.mjs",
      "packages/coding-agent/src/cli/args.ts:87-95,102-108,131-149,178-179",
      "packages/coding-agent/src/modes/print-mode.ts:96-107,121-171",
