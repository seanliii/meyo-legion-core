 /**
+ * Preserve an explicit no-retry fact from an HTTP error's SDK metadata. A status alone,
+ * an error message, or a string-valued body flag must not make a rejection permanent.
+ * OpenAI exposes the parsed error at `error`; Anthropic may retain the whole body there.
+ */
+function isExplicitlyNonRetryableHttpError(error: unknown): boolean {
+  return anyInCauseChain(error, (level) => {
+    const err = level as {
+      status?: unknown;
+      statusCode?: unknown;
+      headers?: { get?: (name: string) => unknown; [key: string]: unknown };
+      error?: { retryable?: unknown; error?: { retryable?: unknown } };
+    };
+    const status = err.status ?? err.statusCode;
+    if (typeof status !== "number" || !Number.isInteger(status) || status < 400 || status > 599) {
+      return false;
+    }
+    const hint =
+      typeof err.headers?.get === "function"
+        ? err.headers.get("x-should-retry")
+        : Object.entries(err.headers ?? {}).find(
+            ([key]) => key.toLowerCase() === "x-should-retry",
+          )?.[1];
+    return hint === "false" || err.error?.retryable === false || err.error?.error?.retryable === false;
+  });
+}
