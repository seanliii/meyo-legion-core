[Unit]
Description=Meyo HTTPS entry
Wants=network-online.target meyo-legion.service
After=network-online.target meyo-legion.service

[Service]
Type=simple
User=meyo-proxy
Group=meyo-proxy
UMask=0077
Environment=XDG_DATA_HOME=/var/lib/meyo-proxy
Environment=XDG_CONFIG_HOME=/var/lib/meyo-proxy
EnvironmentFile=/etc/meyo-legion/proxy.env
ExecStart=/opt/meyo-legion/proxy/caddy run --config /etc/meyo-legion/Caddyfile
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
